// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  image String?
  clerkId String @unique
  // GitHub connection for "Push to GitHub" (OAuth). The token is encrypted with ENV_VARS_SECRET.
  githubLogin          String?
  githubTokenEncrypted String?

    projects Project[]
    chats    Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 
}

// A project groups chats, like a v0 project.
model Project {
  id String @id @default(cuid())
  name String
  userId String
  user User @relation(fields: [userId] , references: [id] , onDelete: Cascade)
  starred Boolean @default(false)
  // Standing rules the agent follows for every chat in this project.
  instructions String?
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chats Chat[]
}

// One conversation and its versions. Chats without a project are drafts.
model Chat {
  id String @id @default(cuid())
  title String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // One persistent E2B sandbox per chat; recreated from the latest version when it expires.
  sandboxId String?
  // Publish: the chat's app deployed to its own Vercel project at a permanent URL.
  vercelProjectName   String?
  publishDeploymentId String?
  publishStatus       String? // building | ready | error
  publishError        String?
  publishedUrl        String?
  publishedAt         DateTime?
  // The version (Fragment) the current or last deployment was made from.
  publishedFragmentId String?
  // Share: an unguessable id for the public read-only page /share/[shareId]; null = private.
  shareId String? @unique
  // Push to GitHub: the repository ("owner/name") and the version last pushed to it.
  githubRepo              String?
  githubBranch            String?
  githubPushedFragmentId  String?
  githubPushedAt          DateTime?
  // Standing rules for this chat only; override project instructions when they conflict.
  instructions String?
  // Favorites are listed first.
  starred Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  steps AgentStep[]
  envVars ChatEnvVar[]
  images GeneratedImage[]

  @@index([userId])
  @@index([projectId])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id String @id @default(cuid())
  content String
  role MessageRole
  type MessageType
  // The model tier a prompt ran on (mini, pro, max); null on replies and older prompts.
  modelTier String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chatId  String
  chat  Chat  @relation(fields: [chatId] , references: [id] , onDelete: Cascade)

  fragments Fragment?
  // Progress of the agent run this prompt started (user messages only).
  steps AgentStep[]
  // Images attached to a prompt (screenshot or mockup to recreate).
  attachments Attachment[]

  @@index([chatId])
}

// An image attached to a user prompt. Resized in the browser before upload, so it is small
// enough to keep in the database; served by /api/attachments/[id] to its owner.
model Attachment {
  id       String @id @default(cuid())
  mimeType String
  data     Bytes

  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// One visible step of an agent run (setting up, reading files, writing files, running a
// command, thinking), shown live in the chat while the run works.
model AgentStep {
  id     String @id @default(cuid())
  // Inngest run id plus a per-run key, so a retried step updates its row.
  runId  String
  key    String
  kind   String // setup | think | read | write | command | check | finish
  label  String
  status String // running | done | error | stopped

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId   String
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  promptId String
  prompt   Message @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([chatId])
}

model Fragment {
  id String @id @default(cuid())
  messageId String @unique
  message Message @relation(fields: [messageId] , references: [id] , onDelete: Cascade)

  sandboxUrl String
  sandboxId  String?
  title String
  files Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usage{
  key String @id
  points Int
  expire DateTime?
}





// An environment variable (e.g. an API key) for a chat's app: written into its sandbox's
// .env.local and sent to its Vercel project on Publish. The value is encrypted at rest
// (AES-256-GCM with ENV_VARS_SECRET) and never sent back to the browser.
model ChatEnvVar {
  id             String @id @default(cuid())
  key            String
  valueEncrypted String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, key])
}

// An image the agent generated for the chat's app (the generateImage tool). Served publicly
// by /api/images/[id] so the app can use it as an <img src> in the preview, a download,
// GitHub or a published site; the id (a cuid) is the only key.
model GeneratedImage {
  id       String @id @default(cuid())
  prompt   String
  mimeType String
  width    Int
  height   Int
  data     Bytes

  createdAt DateTime @default(now())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
